# Ignore everything by default
*

# Allow Git to look inside folders
!*/

# Explicitly allow Hyprland and core Wayland tools
!.config/hypr/
!.config/waybar/
!.config/rofi/
!.config/wofi/
!.config/dunst/
!.config/mako/
!.config/kitty/
!.config/alacritty/

# Shell and Environment setups
!.bashrc
!.zshrc
!.config/environment.d/

# Block known session runtime artifacts from bleeding in
**/hyprland.log
**/.cache/
